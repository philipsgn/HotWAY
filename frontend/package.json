{
  "name": "hotway-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', {recursive:true,force:true}); console.log('Cleaned .next'); } catch(e){}\"",
    "clean:cache": "node -e \"try { require('fs').rmSync('.next/cache', {recursive:true,force:true}); console.log('Cleaned .next/cache'); } catch(e){}\"",
    "dev": "npm run clean:cache && next dev -p 3001",
    "dev:clean": "npm run clean && next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "maplibre-gl": "^4.1.0",
    "deck.gl": "^9.0.0",
    "lucide-react": "^0.363.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0"
  }
}
